# Compatibility only: prefer DocumentRoot /absolute/path/to/tiles/public.
# Explicit allowlist; private project files are never served by a -f/-d bypass.
Options -Indexes
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^$ public/index.php [L]
  RewriteRule ^(index|admin|api|widgets|media)\.php$ public/$1.php [L,QSA]
  RewriteRule ^uploads/([A-Za-z0-9_-]+\.(?:jpe?g|png|webp|gif|pdf))$ public/media.php?file=$1 [L,QSA,NC]
  RewriteRule ^assets/(.+)$ public/assets/$1 [L]
  RewriteRule ^robots\.txt$ public/robots.txt [L]
  # Permit internal rewrites into public/; its own rules apply afterwards.
  RewriteRule ^public/(?:index|admin|api|widgets|media)\.php$ - [L]
  RewriteRule ^public/assets/ - [L]
  RewriteRule ^public/robots\.txt$ - [L]
  RewriteRule ^ - [R=404,L]
</IfModule>
<IfModule !mod_rewrite.c>
  Require all denied
</IfModule>
