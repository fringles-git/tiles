# Static assets must never execute scripts, even if a file is accidentally added here.
<FilesMatch "\.(?:php[0-9]?|phtml|phar)$">
  Require all denied
</FilesMatch>

# Font files never change under the same name (see fonts/LICENSES.md): cache for a year.
<IfModule mod_headers.c>
  <FilesMatch "\.woff2$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  # ES modules (self-hosted MapLibre) must be served as JavaScript or the browser refuses them.
  AddType text/javascript .mjs
</IfModule>
